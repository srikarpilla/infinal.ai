# Copy this file to .env and fill in your real key.
# Never commit the real .env file to git.

LLM_API_KEY=sk-round2-xxxxxxxxxxxxxxxxxxxxxxxxxxxx
LLM_BASE_URL=https://llm.ganeshnayak.in/v1
LLM_MODEL=gpt-5.5

# Windows only: HyperFrames' bundled Chromium can crash on some machines.
# Point it at your real installed Chrome instead. Adjust the path if yours
# is somewhere else (e.g. "C:\Program Files (x86)\Google\Chrome\Application\chrome.exe").
HYPERFRAMES_BROWSER_PATH=C:\Program Files\Google\Chrome\Application\chrome.exe
